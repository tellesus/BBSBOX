{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BBSBOX Native Check",
  "version": "0.1.0",
  "identifier": "org.bbsbox.foundation.native-check",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
